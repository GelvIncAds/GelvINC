rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user matches target id
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Public read for inventory items, writes require authentication
    match /inventory/{itemId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // User profiles can be read by authenticated users, written by owner
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // Branch requests can be read and created by authenticated users
    match /branch_requests/{requestId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
